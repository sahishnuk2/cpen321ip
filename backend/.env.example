# Backend HTTP server
PORT=3000

# Google OAuth web client ID used to verify Android ID tokens
GOOGLE_WEB_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com

# Values returned by the M1 backend APIs
SERVER_PUBLIC_IP=your_server_public_ip
STUDENT_FIRST_NAME=your_first_name
STUDENT_LAST_NAME=your_last_name
